SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel login. Use a passphrase, not a word.
ADMIN_PASSWORD=
# Signs the admin session cookie. Optional — falls back to ADMIN_PASSWORD.
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# REQUIRED. Vercel Cron sends this as `Authorization: Bearer $CRON_SECRET` on
# every scheduled invocation; /api/cron/* and /api/manual/* reject callers that
# present neither this nor a signed admin session. Without it, scheduled runs
# fail closed with a 503. Generate with: openssl rand -hex 32
CRON_SECRET=

# Signs unsubscribe tokens. Set this explicitly — if it's unset the code falls
# back to ADMIN_PASSWORD, and rotating the password then breaks every
# unsubscribe link already delivered to subscribers.
# Generate with: openssl rand -hex 32
UNSUBSCRIBE_SECRET=
# Comma-separated retired secrets that must still verify (never sign), so links
# in already-delivered emails keep working across a rotation.
UNSUBSCRIBE_SECRET_LEGACY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

EXA_API_KEY=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public URL for sitemap/robots (set in Vercel project settings)
# On Vercel, VERCEL_URL is auto-set — only override if you have a custom domain
NEXT_PUBLIC_BASE_URL=https://your-domain.com
